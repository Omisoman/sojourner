# sojourner — compose reads this (make passes --env-file .env when present).
# Copy to .env only to change a default; nothing here is required.

# Where staging (the deployed new-horizons) is published on the host.
STAGING_PORT=8080

# llm-proxy's upstream: host Ollama by default; a rented OpenAI-compatible box
# (plain HTTP) in the rented lane. `make llm-target` sets it.
LLM_UPSTREAM=host.docker.internal:11434

# Claude lane only (`make llm-target MODE=claude`, compose --profile claude):
# the key lives in the litellm gateway, never in a tier.
# ANTHROPIC_API_KEY=
# LITELLM_MASTER_KEY=sojourner-gateway-key
