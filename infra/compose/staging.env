# staging env — the deployed app's runtime: the farm database and a model.
# No Gitea, no A2A secret, no deploy rights: staging only serves.
# the deployed code is read-only; its data lives on the staging-farm volume
HORIZONS_DATA=/srv/farm/data
DATABASE_URL=postgresql://horizons:horizons@horizons-postgres:5432/horizons
DATABASE_URL_RO=postgresql://farm_ro:farm-ro@horizons-postgres:5432/horizons
LLM_BASE_URL=http://llm-proxy:11434/v1
LLM_API_KEY=ollama
LLM_PROVIDER=local
LLM_LANE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_DEFAULT=qwen3:8b
OLLAMA_HOST=http://llm-proxy:11434
