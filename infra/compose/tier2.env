# tier2 env — ops credentials (demo values; production = a real secrets store).
LLM_BASE_URL=http://llm-proxy:11434/v1
LLM_API_KEY=ollama
# the lane (scripts/llm-target.sh in new-horizons): the tier's Inference screen states it
LLM_PROVIDER=local
LLM_LANE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_DEFAULT=qwen3:8b
# embeddings (bge-m3) for the gate's scorecard: always the local Ollama, via the proxy
OLLAMA_HOST=http://llm-proxy:11434
A2A_JWT_SECRET=sojourner-demo-a2a-jwt-secret-0123456789abcdef
# new-horizons' Postgres (horizons-db network): the ONE audit chain + the farm data
DATABASE_URL=postgresql://horizons:horizons@horizons-postgres:5432/horizons
DATABASE_URL_RO=postgresql://farm_ro:farm-ro@horizons-postgres:5432/horizons
GITEA_URL=http://gitea:3000
GITEA_USER=sojourner-ops
GITEA_PASSWORD=sojourner-ops-demo-pass1
GITEA_REPO=new-horizons
NTFY_URL=http://ntfy
NTFY_TOPIC=sojourner-ops
STAGING_DIR=/srv/staging
STAGING_RUN_DIR=/srv/staging-run
STAGING_URL=http://staging:8501/
# What a human opens on the demo machine (caddy publishes :8080 via staging-view).
STAGING_PUBLIC_URL=http://localhost:8080/
AUDIT_JSONL=/var/log/sojourner-audit/tier2-audit.jsonl
